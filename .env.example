# ==============================================================================
# FudoExtractor v2 - Variables de Entorno y Configuración
# ==============================================================================

# Clave de API de Google Gemini (Obtener gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelos recomendados de Gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite

# (Opcional) API de OpenAI para contingencia secundaria
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reglas de negocio contable
MAX_DIAS_ANTIGUEDAD=60
PAUSA_ENTRE_TICKETS=1.5

# OCR local opcional (EasyOCR / Tesseract)
OCR_COMO_AYUDA=0
OCR_SI_FALLA_IA=0
